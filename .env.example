# Public app origin — used for OG image metadataBase and anywhere else a
# server component needs the canonical URL outside of a request context.
NEXT_PUBLIC_APP_URL=https://example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rotating QR token signing
PASS_TOKEN_SECRET=

# Apple Wallet (BLOCKED on open question #2 — Apple Developer Pass Type ID + cert owner TBD)
# passkit-generator needs a Pass Type ID certificate exported as WWDR + signerCert + signerKey.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_WWDR_CERT_PATH=./certs/wwdr.pem
APPLE_SIGNER_CERT_PATH=./certs/signerCert.pem
APPLE_SIGNER_KEY_PATH=./certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_PASS_WEB_SERVICE_URL=https://example.com/api/apple/v1

# APNs (pass update pushes)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=./certs/apns-key.p8

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=

# SumUp POS integration (see README) — OAuth app registered in SumUp's
# developer portal (For Developers → Toolkit); SUMUP_REDIRECT_URI must
# exactly match the one static callback URL registered there — OAuth
# providers match redirect_uri exactly, so it can't vary per merchant —
# e.g. https://your-app.example.com/api/sumup/callback. Which merchant a
# callback is for travels through the OAuth `state` param instead.
# SUMUP_WEBHOOK_SECRET is whatever secret you configure for your webhook
# endpoint in the same portal — used to verify the x-payload-signature
# header on every inbound webhook.
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_REDIRECT_URI=
SUMUP_OAUTH_SCOPES=
SUMUP_WEBHOOK_SECRET=

# Web Push (P1)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Marketing site: merchant lead notifications (H3)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_NOTIFICATION_FROM=
LEAD_WEBHOOK_URL=

# Marketing site: analytics (H7). Plausible is what's wired up (cookie-less,
# so "no cookie banner required" holds without extra work) — set your site
# domain to turn it on; leave blank to no-op. Swap for PostHog later if
# preferred, same track() call sites.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
